<UserControl x:Class="PersonalAutomationTool.Modules.PassaggioConsegne.PassaggioConsegneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PersonalAutomationTool.Modules.PassaggioConsegne"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="#F4F6F9">

    <UserControl.DataContext>
        <local:PassaggioConsegneViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="RapportinoHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#C8E6C9"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#81C784"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="PeachTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="BorderBrush" Value="#FFB74D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CellTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Stile per i Bottoni di Selezione Template (ETR 700 / 1000 / 500) -->
        <Style x:Key="TemplateButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F0F4F1"/>
            <Setter Property="Foreground" Value="#2E7D32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="6" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C8E6C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- Toolbar di navigazione e azioni -->
            <Border Background="White" CornerRadius="12" Padding="18,15" Margin="0,0,0,20" BorderBrush="#E0E6ED" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selezione Template Treno (Pulsanti Grandi e Intuitivi) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Template:" VerticalAlignment="Center" FontWeight="Bold" FontSize="18" Margin="0,0,20,0" Foreground="#2C3E50"/>
                        
                        <Button Content="ETR 700" Command="{Binding SelectEtr700Command}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TemplateButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEtr700Selected}" Value="True">
                                            <Setter Property="Background" Value="#1B5E20"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="ETR 1000" Command="{Binding SelectEtr1000Command}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TemplateButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEtr1000Selected}" Value="True">
                                            <Setter Property="Background" Value="#1B5E20"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="ETR 500" Command="{Binding SelectEtr500Command}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TemplateButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEtr500Selected}" Value="True">
                                            <Setter Property="Background" Value="#1B5E20"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Bottoni Azione -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+ Aggiungi Intervento" Command="{Binding AggiungiInterventoCommand}" 
                                Height="45" Padding="14,8" Margin="0,0,10,0" Background="#2E7D32" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="Salva Dati" Command="{Binding SalvaDatiCommand}" 
                                Height="45" Padding="14,8" Margin="0,0,10,0" Background="#1976D2" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="Passaggio di consegne" Click="BtnPassaggioConsegne_Click" 
                                Height="45" Padding="14,8" Margin="0,0,10,0" Background="#00796B" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button Content="Reset Rapportino" Command="{Binding ResetCommand}" 
                                Height="45" Padding="14,8" Background="#FFEBEE" Foreground="#C62828" FontSize="14" FontWeight="Bold" BorderBrush="#FFCDD2" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- FOGLIO RAPPORTINO TURNO -->
            <Border x:Name="RapportinoSheetBorder" Background="White" CornerRadius="4" BorderBrush="#CCCCCC" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="10" ShadowDepth="3"/>
                </Border.Effect>

                <StackPanel>

                    <!-- INTESTAZIONE RAPPORTINO -->
                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <!-- Cella ISMAN -->
                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0" Background="#F5F5F5" Padding="5">
                                <TextBlock Text="ISMAN" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#222"/>
                            </Border>

                            <!-- Cella Titolo RAPPORTINO TURNO -->
                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Background="White">
                                <TextBlock Text="RAPPORTINO TURNO" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Cella Etichetta DATA -->
                            <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,1" Background="#F5F5F5">
                                <TextBlock Text="DATA" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Cella Input DATA -->
                            <Border Grid.Row="0" Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,0,1" Background="#FFF3E0" Padding="2">
                                <TextBox Text="{Binding SelectedRapportino.Data, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource PeachTextBoxStyle}" FontWeight="Bold" HorizontalContentAlignment="Center"/>
                            </Border>

                            <!-- Riga 1: Nome, Cognome, Ora Inizio, Ora Fine -->
                            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <!-- NOME -->
                                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0" Background="#F5F5F5">
                                    <TextBlock Text="NOME" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0" Background="#FFF3E0" Padding="2">
                                    <TextBox Text="{Binding SelectedRapportino.Nome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PeachTextBoxStyle}"/>
                                </Border>

                                <!-- COGNOME -->
                                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0" Background="#F5F5F5">
                                    <TextBlock Text="COGNOME" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,1,0" Background="#FFF3E0" Padding="2">
                                    <TextBox Text="{Binding SelectedRapportino.Cognome, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PeachTextBoxStyle}"/>
                                </Border>

                                <!-- ORA INIZIO -->
                                <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0,0,1,0" Background="#F5F5F5">
                                    <TextBlock Text="ORA INIZIO" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0,0,1,0" Background="#FFF3E0" Padding="2">
                                    <TextBox Text="{Binding SelectedRapportino.OraInizio, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PeachTextBoxStyle}" HorizontalContentAlignment="Center"/>
                                </Border>

                                <!-- ORA FINE -->
                                <Border Grid.Column="6" BorderBrush="Black" BorderThickness="0,0,1,0" Background="#F5F5F5">
                                    <TextBlock Text="ORA FINE" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="7" Background="#FFF3E0" Padding="2">
                                    <TextBox Text="{Binding SelectedRapportino.OraFine, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PeachTextBoxStyle}" HorizontalContentAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- BANNER VERDE PROSPETTO -->
                    <Border Background="#1B5E20" Padding="8" Margin="0,5,0,0">
                        <TextBlock Text="ATTIVITA' RICHIESTE DA INGEGNERIA HR STS" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#2E7D32" Padding="6" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedRapportino.NotaUfficioCt}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- SEZIONE 1: TABELLA MOVIMENTI (10 RIGHE) -->
                    <DataGrid ItemsSource="{Binding SelectedRapportino.Movimenti}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="Gray" VerticalGridLinesBrush="Gray"
                              BorderBrush="Black" BorderThickness="1" ColumnHeaderStyle="{StaticResource RapportinoHeaderStyle}"
                              Margin="0,0,0,25" ScrollViewer.CanContentScroll="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="40" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="TRENO" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Treno, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="LOCO" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Loco, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DATA INGRESSO" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DataIngresso, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ORA INGRESSO" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding OraIngresso, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DATA USCITA" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DataUscita, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ORA USCITA" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding OraUscita, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- SEZIONE 2: DETTAGLIO INTERVENTI BANNER -->
                    <Border Background="#F5F5F5" BorderBrush="Black" BorderThickness="1,1,1,0" Padding="8">
                        <TextBlock Text="DETTAGLIO INTERVENTI (CORRETTIVA, PREVENTIVA, RICHIESTE INGEGNERIA)" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- TABELLA DETTAGLIO INTERVENTI -->
                    <DataGrid ItemsSource="{Binding SelectedRapportino.Interventi}" AutoGenerateColumns="False" 
                              CanUserAddRows="True" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="Gray" VerticalGridLinesBrush="Gray" MinHeight="150"
                              BorderBrush="Black" BorderThickness="1" ColumnHeaderStyle="{StaticResource RapportinoHeaderStyle}"
                              Margin="0,0,0,25" ScrollViewer.CanContentScroll="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="TRENO-LOCO" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TrenoLoco, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="DESCRIZIONE" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Descrizione, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="COMPILAZIONE ODL" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding CompilazioneOdlBool, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="CHIUSURA TICKET&#10;MAXIMO+ EMAIL" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding ChiusuraTicketBool, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="COMP.REPORT&#10;INTERVENTI" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding CompReportBool, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="EMAIL AD&#10;INGEGNERIA" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding EmailIngegneriaBool, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="AGGIORNARE FILE&#10;VERIFICHE" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding AggiornareVerificheBool, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- SEZIONE 3: INTERVENTI NON SVOLTI BANNER -->
                    <Border Background="#F5F5F5" BorderBrush="Black" BorderThickness="1,1,1,0" Padding="8">
                        <TextBlock Text="INTERVENTI RICHIESTI DA INGEGNERIA NON SVOLTI SU TRENI IN CANTIERE" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- TABELLA INTERVENTI NON SVOLTI (10 RIGHE) -->
                    <DataGrid ItemsSource="{Binding SelectedRapportino.InterventiNonSvolti}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="Gray" VerticalGridLinesBrush="Gray"
                              BorderBrush="Black" BorderThickness="1" ColumnHeaderStyle="{StaticResource RapportinoHeaderStyle}"
                              Margin="0,0,0,10" ScrollViewer.CanContentScroll="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="40" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="TRENO-LOCO" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TrenoLoco, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="MOTIVAZIONE" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Motivazione, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ORA RICHIESTA" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding OraRichiesta, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="REFERENTE&#10;TRENITALIA o HR" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Referente, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="INVIATA EMAIL AD&#10;INGEGNERIA" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding InviataEmailBool, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="PASSAGGIO DI&#10;CONSEGNA" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PassaggioConsegna, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CellTextBoxStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
