<Window x:Class="PersonalAutomationTool.Modules.PassaggioConsegne.StatoTurnoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stato del turno"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">

    <StackPanel Margin="24">
        <TextBlock Text="Qual è lo stato delle attività per questo turno?" FontSize="16"
                   FontWeight="SemiBold" Foreground="#1F2937" TextWrapping="Wrap"/>
        <TextBlock Text="La scelta determina il colore e il testo del corpo dell'email."
                   Margin="0,6,0,20" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>

        <!-- Style="{x:Null}" su tutti e quattro: senza, i Button ereditano implicitamente lo stile
             globale di MaterialDesignThemes (caricato in App.xaml, si applica a ogni Button senza uno
             Style esplicito) che li ritaglia nel proprio chrome pensato per etichette brevi in
             maiuscolo, tagliando il testo su due righe come "Non ci sono attività da svolgere". Con
             Style="{x:Null}" si torna al Button di sistema, che rispetta Background/Foreground/Padding
             locali senza ritagliare nulla — lo stesso motivo per cui "PulsanteAzione"/"PulsantePrimario"
             nella vista principale usano uno Style con nome invece di lasciare quello implicito. -->
        <Button x:Name="BtnNessunaAttivita" Content="Non ci sono attività da svolgere" Style="{x:Null}"
                Margin="0,0,0,10" Padding="12,10" HorizontalContentAlignment="Left"
                Background="#E8F5E9" BorderBrush="#A5D6A7" Foreground="#1B5E20"
                FontWeight="SemiBold" Cursor="Hand" Click="NessunaAttivita_Click"/>

        <Button x:Name="BtnAttivitaPreviste" Content="Ci sono attività previste" Style="{x:Null}"
                Margin="0,0,0,10" Padding="12,10" HorizontalContentAlignment="Left"
                Background="#FFF8E1" BorderBrush="#FFD54F" Foreground="#8A6100"
                FontWeight="SemiBold" Cursor="Hand" Click="AttivitaPreviste_Click"/>

        <Button x:Name="BtnAttivitaImminenti" Content="Ci sono attività imminenti o in corso" Style="{x:Null}"
                Margin="0,0,0,20" Padding="12,10" HorizontalContentAlignment="Left"
                Background="#FFEBEE" BorderBrush="#EF9A9A" Foreground="#B71C1C"
                FontWeight="SemiBold" Cursor="Hand" Click="AttivitaImminenti_Click"/>

        <Button Content="Annulla" Style="{x:Null}" Width="100" Padding="10,6" HorizontalAlignment="Right"
                Background="#F0F0F0" BorderBrush="#CCCCCC" Foreground="#333333"
                IsCancel="True" Click="Annulla_Click"/>
    </StackPanel>
</Window>
