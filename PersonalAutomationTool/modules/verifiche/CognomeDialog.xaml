<Window x:Class="PersonalAutomationTool.Modules.Verifiche.CognomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verifica Eseguita"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">

    <StackPanel Margin="20">
        <TextBlock Text="Cognome?" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937"/>

        <TextBlock x:Name="TxtRiepilogo" Margin="0,6,0,0" FontSize="12" Foreground="#6B7280"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="TxtCognome" Margin="0,14,0,0" Padding="6,5" FontSize="14"
                 BorderBrush="#D1D5DB" VerticalContentAlignment="Center"
                 KeyDown="TxtCognome_KeyDown"/>

        <TextBlock x:Name="TxtErrore" Margin="0,6,0,0" FontSize="12" Foreground="#D32F2F"
                   Visibility="Collapsed" Text="Inserire un cognome per proseguire."/>

        <!-- Style="{x:Null}": senza, i Button ereditano implicitamente lo stile globale di
             MaterialDesignThemes (caricato in App.xaml), il cui chrome ritaglia il contenuto pensando
             a etichette brevi in maiuscolo — lo stesso bug corretto in StatoTurnoDialog.xaml
             (PASSAGGIO CONSEGNE, §6.1-sedecies di PROJECT_MEMORY.md). Con Style="{x:Null}" si torna al
             Button di sistema, che rispetta Background/Foreground/Padding locali senza ritagliare. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annulla" Style="{x:Null}" Width="100" Padding="10,6" Margin="0,0,10,0"
                    Background="#F0F0F0" BorderBrush="#CCCCCC" Foreground="#333333"
                    IsCancel="True" Click="Annulla_Click"/>
            <Button Content="Conferma" Style="{x:Null}" Width="100" Padding="10,6"
                    Background="#E8F5E9" BorderBrush="#A5D6A7" Foreground="#1B5E20"
                    FontWeight="SemiBold" IsDefault="True" Click="Conferma_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
