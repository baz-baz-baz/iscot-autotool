<UserControl x:Class="PersonalAutomationTool.Modules.Verifiche.VerificheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PersonalAutomationTool.Modules.Verifiche"
             xmlns:controls="clr-namespace:PersonalAutomationTool.Core.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:VerificheViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="CenteredBoldTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="CenteredBoldTextWrapStyle" TargetType="TextBlock" BasedOn="{StaticResource CenteredBoldTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="VerificheHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5,5,15,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Stile condiviso delle tre griglie di flotta.
             Nessuna viewport vincolata (vedi il commento sul layout più sotto): la griglia si
             dimensiona sul proprio contenuto e non scorre mai al proprio interno. Su richiesta
             esplicita del committente questa sessione ha ripristinato il comportamento precedente
             alla virtualizzazione introdotta nello Sprint 2 (§4.17 di PROJECT_MEMORY.md): con i
             volumi reali di Verifiche (decine di righe, non migliaia) la pagina intera che scorre
             è più leggibile delle tre viewport separate, e il costo di non virtualizzare più è
             trascurabile a quei volumi. Vedi §6.1-quinquies. -->
        <Style x:Key="VerificheGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="LightGray"/>
            <Setter Property="VerticalGridLinesBrush" Value="LightGray"/>
            <Setter Property="BorderBrush" Value="#9ACD32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource VerificheHeaderStyle}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <DataTemplate x:Key="RiassuntoTrenoTemplate">
            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="6">
                <TextBlock Text="{Binding Treno}" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>

        <!-- Colonna "Verifica Eseguita", identica nelle tre tabelle di flotta.
             Il comando sta sul ViewModel mentre il DataContext della cella è la riga: da qui il
             percorso RelativeSource verso lo UserControl, con la riga passata come parametro.
             Il pulsante si disabilita se la riga non porta con sé la propria origine nel file
             (SourceFilePath + SourceRowNumber): meglio un pulsante spento che un'archiviazione
             applicata alla riga sbagliata. -->
        <DataTemplate x:Key="VerificaEseguitaCellTemplate">
            <Button Content="Verifica Eseguita"
                    Margin="4" Padding="10,5"
                    Background="#E8F5E9" BorderBrush="#A5D6A7" Foreground="#1B5E20"
                    FontWeight="SemiBold" FontSize="12" Cursor="Hand"
                    IsEnabled="{Binding PuoEssereArchiviata}"
                    Command="{Binding DataContext.VerificaEseguitaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="Archivia la riga nel foglio storico, la rimuove dall'elenco e rinomina il file."/>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Torna a ScrollViewer > StackPanel su richiesta esplicita del committente (§6.1-quinquies):
         uno StackPanel concede ai figli altezza infinita, quindi nessuna sezione riceve una
         viewport vincolata — ogni tabella si dimensiona sul proprio contenuto per intero, senza
         una barra di scorrimento propria, e a scorrere è la pagina nel suo complesso. -->
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Tabella Riassuntiva (Solo Treni) -->
            <TextBlock Text="RIASSUNTO TRENI CON VERIFICHE" FontWeight="Bold" FontSize="16" Foreground="#333333" Margin="0,0,0,5" HorizontalAlignment="Center"/>

            <Border BorderBrush="#9ACD32" BorderThickness="2" Margin="0,0,0,30" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Intestazioni -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#9ACD32" Padding="8" BorderBrush="LightGray" BorderThickness="0,0,1,1">
                        <TextBlock Text="500" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Background="#9ACD32" Padding="8" BorderBrush="LightGray" BorderThickness="0,0,1,1">
                        <TextBlock Text="700" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="#9ACD32" Padding="8" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                        <TextBlock Text="1000" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Dati -->
                    <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding VerificheList500}"
                                  ItemTemplate="{StaticResource RiassuntoTrenoTemplate}"/>

                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VerificheList700}"
                                  ItemTemplate="{StaticResource RiassuntoTrenoTemplate}"/>

                    <ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding VerificheList1000}"
                                  ItemTemplate="{StaticResource RiassuntoTrenoTemplate}"/>
                </Grid>
            </Border>

            <!-- Tabella ETR 500 -->
            <Border Background="#9ACD32" Padding="10" CornerRadius="0">
                <TextBlock Text="VERIFICHE ETR500" FontWeight="Bold" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
            </Border>
            <DataGrid ItemsSource="{Binding VerificheList500}" Style="{StaticResource VerificheGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TRENO" Binding="{Binding Treno}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="LOCO" Binding="{Binding Loco}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="Avaria segnalata da ING/SVI" Binding="{Binding Avaria}" Width="*" ElementStyle="{StaticResource CenteredBoldTextWrapStyle}"/>
                    <DataGridTemplateColumn Header="AZIONE" Width="170" CellTemplate="{StaticResource VerificaEseguitaCellTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tabella ETR 700 -->
            <Border Background="#9ACD32" Padding="10" CornerRadius="0">
                <TextBlock Text="VERIFICHE ETR700" FontWeight="Bold" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
            </Border>
            <DataGrid ItemsSource="{Binding VerificheList700}" Style="{StaticResource VerificheGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TRENO" Binding="{Binding Treno}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="LOCO" Binding="{Binding Loco}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="Avaria segnalata da ING/SVI" Binding="{Binding Avaria}" Width="*" ElementStyle="{StaticResource CenteredBoldTextWrapStyle}"/>
                    <DataGridTemplateColumn Header="AZIONE" Width="170" CellTemplate="{StaticResource VerificaEseguitaCellTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tabella ETR 1000 -->
            <Border Background="#9ACD32" Padding="10" CornerRadius="0">
                <TextBlock Text="VERIFICHE ETR1000" FontWeight="Bold" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
            </Border>
            <DataGrid ItemsSource="{Binding VerificheList1000}" Style="{StaticResource VerificheGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TRENO" Binding="{Binding Treno}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="LOCO" Binding="{Binding Loco}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="Avaria segnalata da ING/SVI" Binding="{Binding Avaria}" Width="*" ElementStyle="{StaticResource CenteredBoldTextWrapStyle}"/>
                    <DataGridTemplateColumn Header="AZIONE" Width="170" CellTemplate="{StaticResource VerificaEseguitaCellTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>

        <!-- Overlay di attesa durante l'archiviazione: copia di backup, riscrittura del pacchetto
             OpenXML e rinomina avvengono su cartelle OneDrive e possono richiedere qualche secondo. -->
        <controls:ProgressOverlay IsBusy="{Binding IsBusy}" Message="{Binding StatoOperazione}"/>
    </Grid>
</UserControl>
