<UserControl x:Class="PersonalAutomationTool.Modules.Verifiche.VerificheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PersonalAutomationTool.Modules.Verifiche"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:VerificheViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="CenteredBoldTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="CenteredBoldTextWrapStyle" TargetType="TextBlock" BasedOn="{StaticResource CenteredBoldTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="VerificheHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5,5,15,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Stile condiviso delle tre griglie di flotta.
             CanContentScroll="True" è la chiave: con "False" (impostazione precedente) il
             DataGrid passa allo scorrimento a pixel e materializza OGNI riga come DataGridRow
             completa di celle e TextBlock. Con "True" si attiva la virtualizzazione nativa e
             restano vive solo le righe effettivamente visibili.
             ScrollUnit resta il default "Item": con la colonna "Avaria" a testo mandato a capo
             le righe hanno altezza variabile, e lo scorrimento per riga mantiene stabile la
             maniglia della barra di scorrimento. -->
        <Style x:Key="VerificheGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="LightGray"/>
            <Setter Property="VerticalGridLinesBrush" Value="LightGray"/>
            <Setter Property="BorderBrush" Value="#9ACD32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource VerificheHeaderStyle}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <!-- Colonne del riepilogo: elenco virtualizzato con viewport propria.
             Un ItemsControl non ha di suo un ScrollViewer, quindi non ha una viewport e non può
             virtualizzare: il template qui sotto gliene fornisce una. -->
        <Style x:Key="RiassuntoListStyle" TargetType="ItemsControl">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RiassuntoTrenoTemplate">
            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="6">
                <TextBlock Text="{Binding Treno}" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Il precedente ScrollViewer > StackPanel è stato sostituito da una Grid a righe
         proporzionali. Motivo: uno StackPanel concede ai figli altezza infinita, quindi nessuna
         griglia al suo interno riceve una viewport vincolata e la virtualizzazione WPF non si
         attiva mai, a prescindere dalle proprietà impostate. Con righe "*" ogni sezione ha
         un'altezza definita e scorre per conto proprio. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabella Riassuntiva (Solo Treni) -->
        <TextBlock Grid.Row="0" Text="RIASSUNTO TRENI CON VERIFICHE" FontWeight="Bold" FontSize="16" Foreground="#333333" Margin="0,0,0,5" HorizontalAlignment="Center"/>

        <!-- MaxHeight: sotto questa soglia il riquadro si dimensiona sul contenuto esattamente
             come prima; oltre, fornisce la viewport vincolata che permette la virtualizzazione. -->
        <Border Grid.Row="1" BorderBrush="#9ACD32" BorderThickness="2" Margin="0,0,0,30" Background="White" MaxHeight="260">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Intestazioni -->
                <Border Grid.Row="0" Grid.Column="0" Background="#9ACD32" Padding="8" BorderBrush="LightGray" BorderThickness="0,0,1,1">
                    <TextBlock Text="500" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#9ACD32" Padding="8" BorderBrush="LightGray" BorderThickness="0,0,1,1">
                    <TextBlock Text="700" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="#9ACD32" Padding="8" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Text="1000" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                </Border>

                <!-- Dati -->
                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding VerificheList500}"
                              Style="{StaticResource RiassuntoListStyle}"
                              ItemTemplate="{StaticResource RiassuntoTrenoTemplate}"
                              BorderBrush="LightGray" BorderThickness="0,0,1,0"/>

                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VerificheList700}"
                              Style="{StaticResource RiassuntoListStyle}"
                              ItemTemplate="{StaticResource RiassuntoTrenoTemplate}"
                              BorderBrush="LightGray" BorderThickness="0,0,1,0"/>

                <ItemsControl Grid.Row="1" Grid.Column="2" ItemsSource="{Binding VerificheList1000}"
                              Style="{StaticResource RiassuntoListStyle}"
                              ItemTemplate="{StaticResource RiassuntoTrenoTemplate}"/>
            </Grid>
        </Border>

        <!-- Le tre tabelle di flotta: righe proporzionali, ognuna con la propria viewport. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <!-- Tabella ETR 500 -->
            <Border Grid.Row="0" Background="#9ACD32" Padding="10" CornerRadius="0">
                <TextBlock Text="VERIFICHE ETR500" FontWeight="Bold" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
            </Border>
            <DataGrid Grid.Row="1" ItemsSource="{Binding VerificheList500}" Style="{StaticResource VerificheGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TRENO" Binding="{Binding Treno}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="LOCO" Binding="{Binding Loco}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="Avaria segnalata da ING/SVI" Binding="{Binding Avaria}" Width="*" ElementStyle="{StaticResource CenteredBoldTextWrapStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tabella ETR 700 -->
            <Border Grid.Row="2" Background="#9ACD32" Padding="10" CornerRadius="0">
                <TextBlock Text="VERIFICHE ETR700" FontWeight="Bold" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
            </Border>
            <DataGrid Grid.Row="3" ItemsSource="{Binding VerificheList700}" Style="{StaticResource VerificheGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TRENO" Binding="{Binding Treno}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="LOCO" Binding="{Binding Loco}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="Avaria segnalata da ING/SVI" Binding="{Binding Avaria}" Width="*" ElementStyle="{StaticResource CenteredBoldTextWrapStyle}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tabella ETR 1000 -->
            <Border Grid.Row="4" Background="#9ACD32" Padding="10" CornerRadius="0">
                <TextBlock Text="VERIFICHE ETR1000" FontWeight="Bold" FontSize="16" Foreground="Black" HorizontalAlignment="Center"/>
            </Border>
            <DataGrid Grid.Row="5" ItemsSource="{Binding VerificheList1000}" Style="{StaticResource VerificheGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TRENO" Binding="{Binding Treno}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="LOCO" Binding="{Binding Loco}" Width="150" ElementStyle="{StaticResource CenteredBoldTextStyle}"/>
                    <DataGridTextColumn Header="Avaria segnalata da ING/SVI" Binding="{Binding Avaria}" Width="*" ElementStyle="{StaticResource CenteredBoldTextWrapStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
