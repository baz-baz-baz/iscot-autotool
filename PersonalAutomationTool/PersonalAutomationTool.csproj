<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      Icona incorporata nell'eseguibile come risorsa Win32: e' quella che Explorer, la taskbar e
      il menu Start mostrano per il .exe. E' distinta dall'Icon="..." di MainWindow.xaml, che
      riguarda la finestra a runtime (barra del titolo e anteprima Alt-Tab): servono entrambe,
      e per questo il file e' dichiarato anche come <Resource> piu' sotto.
    -->
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
    <!--
      Versione confrontata da AutoUpdateService (core/AutoUpdateService.cs) con il tag_name
      dell'ultima release GitHub. Senza questa proprietà l'SDK userebbe il default fisso "1.0.0.0"
      per ogni build, e l'auto-update non vedrebbe mai una versione locale "vecchia".
      OBBLIGATORIO a ogni release: prima di "dotnet publish", allineare questo numero al tag Git
      della release (es. tag "v1.0.5" -> <Version>1.0.5</Version>), altrimenti l'eseguibile
      pubblicato non riconoscerà se stesso come aggiornato e riproporrà l'update all'infinito.
    -->
    <Version>2.0.4</Version>
  </PropertyGroup>

  <!--
    ============================ PROFILO DI DISTRIBUZIONE ============================
    Pubblicazione stand-alone per le macchine d'officina, che NON hanno il runtime .NET
    installato e non possono riceverlo (§3 "Requisiti di Sistema"). Comando di release:

        dotnet publish PersonalAutomationTool/PersonalAutomationTool.csproj -c Release -r win-x64

    Tutto questo blocco è attivo SOLO quando si passa un RuntimeIdentifier esplicito: dotnet
    build, dotnet run e dotnet test non ne passano mai uno, quindi il lavoro quotidiano di
    sviluppo resta identico a prima (framework-dependent, build rapida).

    - SelfContained: il runtime .NET viaggia dentro il pacchetto. È ciò che rende l'eseguibile
      distribuibile per copia, senza installare nulla sui PC dei tecnici.
    - PublishSingleFile + IncludeAllContentForSelfExtract: un solo .exe invece di centinaia di
      file. IncludeAllContentForSelfExtract estrae TUTTO il contenuto (non solo gli assembly
      gestiti) in una cartella temporanea prima dell'avvio: serve alle dipendenze native —
      e_sqlite3.dll di SQLitePCLRaw su tutte — che altrimenti non verrebbero trovate.
    - PublishReadyToRun: pre-compila in codice nativo. Sui dischi lenti delle macchine legacy
      è la differenza fra un avvio a freddo immediato e diversi secondi di JIT (§3, vincolo 4).
    - EnableCompressionInSingleFile: comprime il pacchetto (~150 MB → ~70 MB). Costa qualche
      decimo di secondo al primo avvio, ma rende molto più sopportabile la copia via rete.

    NON abilitato il trimming: XAML e le chiamate dynamic verso Excel/Outlook si basano su
    riflessione, e il trimmer romperebbe cose in modo difficile da diagnosticare.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <ApplicationDefinition Include="main\App.xaml" />
  </ItemGroup>

  <!--
    Stesso file dell'ApplicationIcon, qui come risorsa WPF: serve a MainWindow.xaml per
    Icon="Resources/app_icon.ico". Essendo incorporata nell'assembly, continua a funzionare
    anche pubblicando in single-file self-contained, dove accanto all'eseguibile non c'e'
    alcuna cartella Resources su disco.
  -->
  <ItemGroup>
    <Resource Include="Resources\app_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!--
      Reso esplicito (era già presente come dipendenza transitiva di ClosedXML, stessa versione:
      nessun pacchetto aggiuntivo da scaricare). Serve per la lettura SAX in streaming di
      VerificheExcelReader: usare direttamente i tipi di un pacchetto transitivo significherebbe
      dipendere da una scelta interna di ClosedXML, che un suo aggiornamento potrebbe cambiare.
    -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Update="modules\database\*.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Gli stessi database seed, incorporati anche come risorsa: Core.AppPaths li scrive nella cartella dati
    (%LOCALAPPDATA%\iscot-autotool) quando nessun'altra origine li fornisce. Così il primo avvio non
    dipende dalla cartella temporanea di estrazione del bundle single-file, né dal fatto che
    IncludeAllContentForSelfExtract resti attivo. LogicalName esplicito e allineato ad
    AppPaths.SeedIncorporati: un nome derivato dal percorso cambierebbe rinominando la cartella.
  -->
  <ItemGroup>
    <EmbeddedResource Include="modules\database\train_software.db" LogicalName="Seed.train_software.db" />
    <EmbeddedResource Include="modules\database\emails.db" LogicalName="Seed.emails.db" />
  </ItemGroup>

  <!--
    Logo dell'intestazione del rapportino di turno, estratto dal template Excel di riferimento.
    Incorporato nell'assembly (non copiato in output) così che PassaggioConsegnePdfExporter non
    dipenda da un file su disco che potrebbe mancare. LogicalName esplicito: il nome derivato
    automaticamente dal percorso cambierebbe se la cartella venisse rinominata, rompendo in silenzio
    il caricamento della risorsa a runtime.
  -->
  <ItemGroup>
    <EmbeddedResource Include="modules\passaggio_consegne\Assets\logo-isman.png">
      <LogicalName>PassaggioConsegne.Logo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
