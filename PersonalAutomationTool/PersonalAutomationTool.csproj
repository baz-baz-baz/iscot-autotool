<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    ReadyToRun: velocizza l'avvio a freddo su dischi lenti pre-compilando il codice nativo per la
    piattaforma target, invece di affidarsi solo alla JIT al primo avvio. Attivo SOLO quando si
    pubblica specificando un RuntimeIdentifier esplicito (es. dotnet publish -c Release -r win-x64):
    dotnet build, dotnet run e dotnet test non passano mai un RID, quindi questo blocco è inerte
    per il lavoro quotidiano e non cambia in alcun modo l'esperienza di sviluppo.
    SelfContained resta a false (framework-dependent, richiede il runtime .NET installato sulla
    macchina): passare a true (pacchetto circa 150 MB più pesante, nessuna dipendenza da runtime
    installato) è una scelta operativa, su come vengono aggiornate le macchine dei tecnici, non
    tecnica, quindi lasciata esplicita a chi pubblica (proprietà SelfContained a true sulla riga
    di comando), non decisa qui.
    NON abilitato il trimming: XAML e le chiamate dynamic verso Excel/Outlook si basano su
    riflessione, e il trimmer romperebbe cose in modo difficile da diagnosticare.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <ApplicationDefinition Include="main\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!--
      Reso esplicito (era già presente come dipendenza transitiva di ClosedXML, stessa versione:
      nessun pacchetto aggiuntivo da scaricare). Serve per la lettura SAX in streaming di
      VerificheExcelReader: usare direttamente i tipi di un pacchetto transitivo significherebbe
      dipendere da una scelta interna di ClosedXML, che un suo aggiornamento potrebbe cambiare.
    -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>
  <ItemGroup>
    <None Update="modules\database\*.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Logo dell'intestazione del rapportino di turno, estratto dal template Excel di riferimento.
    Incorporato nell'assembly (non copiato in output) così che PassaggioConsegnePdfExporter non
    dipenda da un file su disco che potrebbe mancare. LogicalName esplicito: il nome derivato
    automaticamente dal percorso cambierebbe se la cartella venisse rinominata, rompendo in silenzio
    il caricamento della risorsa a runtime.
  -->
  <ItemGroup>
    <EmbeddedResource Include="modules\passaggio_consegne\Assets\logo-isman.png">
      <LogicalName>PassaggioConsegne.Logo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
