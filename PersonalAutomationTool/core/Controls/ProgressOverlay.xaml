<UserControl x:Class="PersonalAutomationTool.Core.Controls.ProgressOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             IsHitTestVisible="{Binding IsBusy, ElementName=Root}">
    <!--
        Estratto dall'overlay di caricamento originale di ExcelView (§4.15/§6.1-bis): stessa grafica
        (ProgressBar circolare MaterialDesign, messaggio sotto), ora come UserControl riutilizzabile
        con due DependencyProperty (IsBusy, Message) invece di essere legato al DataContext di una
        singola view. Funziona sia da XAML MVVM (binding) sia da code-behind puro (assegnazione
        diretta delle proprietà, vedi PdfView) — nessuna delle due modalità richiede un ViewModel.
    -->
    <Grid Panel.ZIndex="1000" Background="#99FFFFFF">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy, ElementName=Root}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0"
                         IsIndeterminate="{Binding IsBusy, ElementName=Root}"
                         Width="64" Height="64" Foreground="#1976D2" />
            <TextBlock Text="{Binding Message, ElementName=Root}" Margin="0,20,0,0" FontSize="18"
                       FontWeight="SemiBold" Foreground="#1976D2" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
